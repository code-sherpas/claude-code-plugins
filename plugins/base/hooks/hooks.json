{
  "description": "Automated checks for agents working in Code Sherpas repositories. Each hook's own message says what it found, what to do about it, and the rule behind it.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/no-browser-left-open.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/no-browser-left-open.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
